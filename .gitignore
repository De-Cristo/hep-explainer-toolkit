# Rendered media. Commit sources, not the pictures and sound.
*.mp4
*.webm
*.wav
*.mp3
# Manim writes frames, partial movies, and TeX caches here.
media/

# Model weights. Kokoro downloads these at runtime; do not commit them.
*.onnx
*.pt
*.safetensors
*.pth
voices-*.bin

# Local renders from video/ (frames, wavs, timings). Sources stay tracked.
video/**/build/

# Node
node_modules/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments. env/requirements.in is the Python 3.12 pin, not a venv.
.venv/
venv/
ENV/
env/*
!env/requirements.in
!env/requirements.txt
!env/setup.sh
