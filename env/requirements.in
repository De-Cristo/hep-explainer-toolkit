# Direct dependencies for the HEP explainer toolkit.
# Python 3.12 only: kokoro>=0.9 does not support 3.13 (a 3.13 resolve
# stops at the 0.7.x line). Transitive pins live in requirements.txt.
#
# Torch is the CPU build. The same version on PyPI is the CUDA wheel
# (2.15.0+cu132), which is the wrong default on a machine with no GPU.

--extra-index-url https://download.pytorch.org/whl/cpu

kokoro==0.9.4
misaki==0.9.4
manim==0.22.1
matplotlib==3.11.2
mplhep==1.3.3
numpy==2.5.4
soundfile==0.14.0
pyyaml==6.0.3
torch==2.15.0+cpu

# Unpinned on purpose. Not part of the confirmed Debian 13 install, and not tested yet.
manim-voiceover

# Read ROOT files from public HEPData or CERN Open Data.
uproot

# Video pipeline tests.
pytest==9.2.0

# Kokoro's English G2P (misaki) loads spaCy's en_core_web_sm at runtime.
# 3.8.0 matches spaCy 3.8.x. The lock already pins this wheel. render-video
# downloads it if the environment does not have it yet.
en-core-web-sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl
